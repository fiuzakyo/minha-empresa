{
  "compilerOptions": {
    "target": "ES2022",
    "lib": [
      "ES2022",
      "DOM",
      "DOM.Iterable"
    ],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "isolatedModules": true,
    "baseUrl": ".",
    "paths": {
      "@/registry/*": [
        "./registry/*"
      ],
      "@/lib/*": [
        "./registry/futuredata/lib/*"
      ],
      "@/hooks/*": [
        "./registry/futuredata/hooks/*"
      ]
    }
  },
  "include": [
    "registry/**/*.ts",
    "registry/**/*.tsx"
  ]
}